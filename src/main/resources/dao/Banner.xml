<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.video.server.dao.BannerDao">

    <select id="findList" parameterType="com.video.server.dto.BannerDTO" resultType="com.video.server.dto.BannerDTO">
        select
        videoType.*
        from banner videoType
        <where>
            <if test="id != null and id != ''">and videoType.id = #{id}</if>
            <if test="createTime != null and createTime != ''">and videoType.create_time = #{createTime}</if>
        </where>
        <if test="current != null and pageSize != null">
            limit #{current},#{pageSize}
        </if>
    </select>

    <select id="findPageCount" parameterType="com.video.server.dto.BannerDTO" resultType="java.lang.Integer">
        select count(*) from video_type videoType
        <where>
            <if test="id != null and id != ''">and videoType.id = #{id}</if>
            <if test="createTime != null and createTime != ''">and videoType.create_time = #{createTime}</if>
        </where>
    </select>

</mapper>
